{
  "name": "vibez-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vibez for the browser — blocks distracting websites when Claude Code / Codex goes idle.",
  "scripts": {
    "build": "bun run build.ts",
    "dev": "bun run build.ts --watch",
    "gen-icons": "bun run scripts/gen-icons.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "firebase": "^11.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/chrome": "^0.0.287",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.7.2"
  }
}
